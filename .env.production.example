DEBUG=false
SECRET_KEY=replace-with-a-random-key-of-at-least-50-characters
JWT_SIGNING_KEY=replace-with-a-different-random-key-of-at-least-50-characters
ALLOWED_HOSTS=nacional.example.org
DATABASE_URL=postgresql://user:password@db.example.org:5432/sistema_nacional?sslmode=require
CACHE_URL=rediss://user:password@cache.example.org:6379/0
CSRF_TRUSTED_ORIGINS=https://nacional.example.org
# Activar solo detrás de un proxy controlado que sobrescriba X-Forwarded-Proto.
TRUST_PROXY_HEADERS=true
NUM_PROXIES=1
SECURE_SSL_REDIRECT=true
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
PORT=8000

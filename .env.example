# Desarrollo. Generar las claves según README antes del primer arranque.
DEBUG=true
SECRET_KEY=replace-with-generated-secret-key
JWT_SIGNING_KEY=replace-with-another-generated-key
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=sistema_nacional
POSTGRES_USER=nacional
POSTGRES_PASSWORD=replace-with-generated-database-password
# Compose reemplaza DATABASE_URL con la conexión interna al servicio db.
# Para usar PostgreSQL local, indicar sus credenciales y puerto aquí.
DATABASE_URL=postgresql://nacional:replace-with-generated-database-password@127.0.0.1:5432/sistema_nacional
CACHE_URL=
TRUST_PROXY_HEADERS=false
NUM_PROXIES=0
# Exclusivamente para seed_demo. Definir una contraseña de al menos 12 caracteres.
DEMO_PASSWORD=
